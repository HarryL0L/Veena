// Veena for Linux: Material You on the desktop.
//
// Navigation rail on the left, the page in the middle, and the player on
// the right, coloured from the song's artwork.

import { ListView, Switch, Palette } from "std-widgets.slint";
import { AmbientScene, SceneInfo } from "ambience.slint";

export { SceneInfo }

export struct Song {
    title: string,
    artist: string,
    detail: string,
    duration: string,
    art: image,
    playing: bool,
    liked: bool,
    kept: bool,
}

export struct LyricLine {
    text: string,
    // -1: already sung, 0: being sung, 1: still to come
    state: int,
    // Word by word, for the line being sung when the lyrics have word
    // timings: the words sung so far and the rest.
    words: bool,
    sung: string,
    rest: string,
}

/// A brick as Settings lists it.
export struct BrickItem {
    name: string,
    detail: string,
    version: string,
    failed: bool,
}

export global Theme {
    in-out property <bool> dark: true;
    // Taken from the artwork of the song playing, for each theme.
    in-out property <color> accent-dark: #a8c7fa;
    in-out property <color> accent-container-dark: #2b4678;
    in-out property <color> accent-light: #3d5d93;
    in-out property <color> accent-container-light: #d8e2ff;
    out property <color> accent: dark ? accent-dark : accent-light;
    out property <color> accent-container: dark ? accent-container-dark : accent-container-light;
    // The window's base, with the panes a step lower (dark) or higher (light).
    out property <color> background: dark ? #111318 : #fafaff;
    out property <color> surface: dark ? #191c20 : #e8e9f0;
    out property <color> surface-container: dark ? #1d2024 : #f0f0f7;
    out property <color> surface-high: dark ? #282a2f : #e6e7ee;
    out property <color> surface-highest: dark ? #33353a : #dcdde5;
    out property <color> on-surface: dark ? #e2e2e9 : #1a1c21;
    out property <color> muted: dark ? #c4c6d0 : #464a54;
    out property <color> outline: dark ? #44474e : #c3c6d0;
    out property <length> radius: 28px;
}

component Icon inherits Image {
    in property <color> tint: Theme.on-surface;
    width: 24px;
    height: 24px;
    colorize: tint;
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 40px;
    in property <length> icon-size: 24px;
    in property <color> tint: Theme.on-surface;
    in property <color> fill: transparent;
    in property <length> corner: self.size / 2;
    out property <bool> hovered: area.has-hover;
    callback clicked;
    width: size;
    height: size;
    border-radius: corner;
    background: area.pressed ? fill.darker(0.2) : area.has-hover ? fill.brighter(0.15) : fill;
    animate border-radius { duration: 280ms; easing: ease-out-back; }
    Rectangle {
        border-radius: root.border-radius;
        background: area.has-hover && root.fill == transparent ? Theme.on-surface.transparentize(0.9) : transparent;
    }
    Icon {
        source: root.icon;
        tint: root.tint;
        width: root.icon-size;
        height: root.icon-size;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Artwork inherits Rectangle {
    in property <image> art;
    in property <length> corner: 12px;
    border-radius: corner;
    clip: true;
    background: Theme.surface-highest;
    Icon {
        visible: art.width == 0;
        source: @image-url("icons/music_note.svg");
        tint: Theme.muted;
        width: min(root.width, root.height) / 3;
        height: self.width;
    }
    Image {
        source: art;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 64px;
    width: 80px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            pill := Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.selected ? Theme.accent-container : area.has-hover ? Theme.on-surface.transparentize(0.92) : transparent;
                animate background { duration: 200ms; }
                Icon {
                    source: root.icon;
                    tint: root.selected ? Theme.accent : Theme.muted;
                }
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.on-surface : Theme.muted;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    // Shown instead of the tick, for chips that are actions.
    in property <image> icon;
    callback clicked;
    height: 36px;
    min-width: text.preferred-width + 32px;
    border-radius: 18px;
    background: selected ? Theme.accent-container : transparent;
    border-width: selected ? 0 : 1px;
    border-color: Theme.outline;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 6px;
        alignment: center;
        if root.selected || root.icon.width > 0: Icon {
            source: root.icon.width > 0 ? root.icon : @image-url("icons/check.svg");
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            tint: Theme.accent;
        }
        text := Text {
            text: root.label;
            vertical-alignment: center;
            color: Theme.on-surface;
            font-weight: 600;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionTitle inherits Text {
    color: Theme.on-surface;
    font-size: 22px;
    font-weight: 700;
}

/// Three bars bouncing like a level meter, for the song that's on.
component PlayingBars inherits Rectangle {
    in property <color> tint: white;
    property <float> t: animation-tick() / 1ms / 1000;
    width: 20px;
    height: 18px;
    for i in 3: Rectangle {
        property <float> level: 0.25 + 0.75 * (sin((root.t * (6 + i * 2.3) + i * 1.9) * 1rad) + 1) / 2;
        x: i * 7px;
        y: root.height - self.height;
        width: 5px;
        height: root.height * self.level;
        border-radius: 2px;
        background: root.tint;
    }
}

/// A dark veil with dancing bars over the artwork of the song that's on.
component PlayingOverlay inherits Rectangle {
    in property <length> corner: 12px;
    border-radius: corner;
    background: #00000066;
    PlayingBars { }
}

// ---------------------------------------------------------------- Song tables

/// What a song row can ask for (sent with the list and the row number).
export enum SongAction {
    play, like, play-next, queue, remove-from-history,
    add-to-playlist, remove-from-playlist, remove-from-kept, remove-from-queue, move-up, move-down,
}

/// A playlist as the Library lists it.
export struct PlaylistItem {
    id: string,
    name: string,
    count: int,
    art: image,
}

/// Column widths shared by the header and the rows.
global Columns {
    out property <length> number: 40px;
    out property <length> artist: 200px;
    out property <length> source: 140px;
    out property <length> like: 40px;
    out property <length> duration: 56px;
}

component TableHeader inherits Rectangle {
    height: 36px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        Text { text: "#"; width: Columns.number; horizontal-alignment: center; vertical-alignment: center; color: Theme.muted; font-size: 13px; }
        Text { text: "Title"; horizontal-stretch: 1; vertical-alignment: center; color: Theme.muted; font-size: 13px; }
        Text { text: "Artist"; width: Columns.artist; vertical-alignment: center; color: Theme.muted; font-size: 13px; }
        Text { text: "From"; width: Columns.source; vertical-alignment: center; color: Theme.muted; font-size: 13px; }
        Rectangle { width: Columns.like; }
        Text { text: "Time"; width: Columns.duration; horizontal-alignment: right; vertical-alignment: center; color: Theme.muted; font-size: 13px; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.outline.transparentize(0.5); }
}

/// Grab to move a row up or down a list. Reports how far the pointer has
/// gone since the press, while dragging and when let go.
component DragHandle inherits Rectangle {
    // Under the pointer or held, so its row keeps showing it.
    out property <bool> active: grab.has-hover || grab.pressed;
    callback moved(length);
    callback dropped();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: grab.pressed ? Theme.accent-container : grab.has-hover ? Theme.on-surface.transparentize(0.9) : transparent;
    Icon {
        source: @image-url("icons/drag_handle.svg");
        tint: grab.pressed ? Theme.accent : Theme.muted;
        width: 20px;
        height: 20px;
    }
    grab := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        moved => {
            if (self.pressed) {
                root.moved(self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.dropped();
            }
        }
    }
}

/// Where a dragged row will land: a line along the row's top or bottom.
component DropLine inherits Rectangle {
    height: 3px;
    border-radius: 1.5px;
    background: Theme.accent;
}

component SongRow inherits Rectangle {
    in property <Song> song;
    in property <int> number;
    in property <int> count;
    // Which list the row is in, for its own actions:
    // 1 recently played, 3 kept, 5 a playlist.
    in property <int> list-kind;
    // Dragging (playlists): this row is the one moving, or where it lands.
    in property <bool> lifted;
    in property <int> drop-line: -1;
    callback action(SongAction);
    callback drag-moved(length);
    callback drag-dropped();
    height: 56px;
    border-radius: 12px;
    background: root.lifted ? Theme.accent-container : song.playing ? Theme.accent-container.transparentize(0.4) : area.has-hover ? Theme.surface-high : transparent;
    border-width: root.lifted ? 2px : 0;
    border-color: Theme.accent;
    ContextMenuArea {
        Menu {
            MenuItem { title: "Play"; activated => { root.action(SongAction.play); } }
            MenuItem { title: "Play next"; activated => { root.action(SongAction.play-next); } }
            MenuItem { title: "Add to queue"; activated => { root.action(SongAction.queue); } }
            MenuSeparator { }
            MenuItem { title: root.song.liked ? "Remove from liked" : "Like"; activated => { root.action(SongAction.like); } }
            MenuItem { title: "Add to playlist…"; activated => { root.action(SongAction.add-to-playlist); } }
            if root.list-kind == 5: MenuSeparator { }
            if root.list-kind == 5: MenuItem { title: "Move up"; enabled: root.number > 1; activated => { root.action(SongAction.move-up); } }
            if root.list-kind == 5: MenuItem { title: "Move down"; enabled: root.number < root.count; activated => { root.action(SongAction.move-down); } }
            if root.list-kind == 5: MenuItem { title: "Remove from playlist"; activated => { root.action(SongAction.remove-from-playlist); } }
            if root.list-kind == 3: MenuSeparator { }
            if root.list-kind == 3: MenuItem { title: "Remove from this computer"; activated => { root.action(SongAction.remove-from-kept); } }
            if root.list-kind == 1: MenuSeparator { }
            if root.list-kind == 1: MenuItem { title: "Remove from recently played"; activated => { root.action(SongAction.remove-from-history); } }
        }
        area := TouchArea {
            mouse-cursor: pointer;
            double-clicked => { root.action(SongAction.play); }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;
                // The number turns into a play button under the pointer.
                Rectangle {
                    width: Columns.number;
                    if !area.has-hover && !root.song.playing: Text {
                        text: root.number;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !area.has-hover && root.song.playing: PlayingBars {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.accent;
                    }
                    if area.has-hover: IconButton {
                        icon: @image-url("icons/play.svg");
                        size: 32px;
                        icon-size: 20px;
                        tint: root.song.playing ? Theme.accent : Theme.on-surface;
                        clicked => { root.action(SongAction.play); }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    Artwork { art: root.song.art; width: 40px; height: 40px; y: (parent.height - self.height) / 2; corner: 8px; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.song.title;
                            color: root.song.playing ? Theme.accent : Theme.on-surface;
                            font-weight: root.song.playing ? 700 : 500;
                            overflow: elide;
                        }
                        if root.song.kept: HorizontalLayout {
                            spacing: 4px;
                            Icon { source: @image-url("icons/offline_pin.svg"); width: 12px; height: 12px; y: 2px; tint: Theme.accent; }
                            Text { text: "Kept on this computer"; color: Theme.muted; font-size: 11px; }
                        }
                    }
                }
                Text { text: root.song.artist; width: Columns.artist; color: Theme.muted; overflow: elide; vertical-alignment: center; }
                Text { text: root.song.detail; width: Columns.source; color: Theme.muted; overflow: elide; vertical-alignment: center; font-size: 13px; }
                Rectangle {
                    width: Columns.like;
                    if area.has-hover || root.song.liked: IconButton {
                        icon: root.song.liked ? @image-url("icons/favorite.svg") : @image-url("icons/favorite_border.svg");
                        tint: root.song.liked ? Theme.accent : Theme.muted;
                        size: 32px;
                        icon-size: 18px;
                        clicked => { root.action(SongAction.like); }
                    }
                }
                Rectangle {
                    width: Columns.duration;
                    // In a playlist, the length gives way to a handle for moving the song.
                    property <bool> grabbing: root.list-kind == 5 && (area.has-hover || root.lifted || handle.active);
                    if !self.grabbing: Text {
                        width: 100%;
                        height: 100%;
                        text: root.song.duration;
                        color: Theme.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        font-size: 13px;
                    }
                    handle := DragHandle {
                        visible: root.list-kind == 5;
                        opacity: parent.grabbing ? 1 : 0;
                        x: parent.width - self.width;
                        y: (parent.height - self.height) / 2;
                        moved(dy) => { root.drag-moved(dy); }
                        dropped => { root.drag-dropped(); }
                    }
                }
            }
        }
    }
    if root.drop-line >= 0: DropLine {
        x: 8px;
        width: root.width - 16px;
        y: root.drop-line == 0 ? -1px : root.height - 2px;
    }
}

component SongTable inherits VerticalLayout {
    in property <[Song]> songs;
    in property <int> list-kind;
    callback action(int, SongAction);
    // A song dragged from one place to another (playlists).
    callback reorder(int, int);
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    TableHeader { }
    ListView {
        for song[i] in root.songs: SongRow {
            song: song;
            number: i + 1;
            count: root.songs.length;
            list-kind: root.list-kind;
            lifted: root.drag-from == i;
            drop-line: root.drag-from >= 0 && root.drag-to == i && i != root.drag-from ? (i < root.drag-from ? 0 : 1) : -1;
            action(a) => { root.action(i, a); }
            drag-moved(dy) => {
                root.drag-from = i;
                root.drag-to = max(0, min(root.songs.length - 1, i + round(dy / self.height)));
            }
            drag-dropped => {
                if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                    root.reorder(root.drag-from, root.drag-to);
                }
                root.drag-from = -1;
                root.drag-to = -1;
            }
        }
    }
}

/// A song in the Recently played row. Right-click for more.
component SongCard inherits Rectangle {
    in property <Song> song;
    callback clicked;
    callback action(SongAction);
    width: 180px;
    height: 236px;
    border-radius: 20px;
    background: area.has-hover ? Theme.surface-high : transparent;
    ContextMenuArea {
        Menu {
            MenuItem { title: "Play"; activated => { root.clicked(); } }
            MenuItem { title: "Play next"; activated => { root.action(SongAction.play-next); } }
            MenuItem { title: "Add to queue"; activated => { root.action(SongAction.queue); } }
            MenuSeparator { }
            MenuItem { title: root.song.liked ? "Remove from liked" : "Like"; activated => { root.action(SongAction.like); } }
            MenuItem { title: "Add to playlist…"; activated => { root.action(SongAction.add-to-playlist); } }
            MenuItem { title: "Remove from recently played"; activated => { root.action(SongAction.remove-from-history); } }
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            width: 160px;
            height: 160px;
            Artwork { art: root.song.art; width: 160px; height: 160px; corner: 20px; }
            if root.song.playing: PlayingOverlay { width: 160px; height: 160px; corner: 20px; }
            // A play button rises in on hover, like desktop music apps.
            IconButton {
                x: parent.width - self.width - 8px;
                y: area.has-hover ? parent.height - self.height - 8px : parent.height - self.height + 4px;
                opacity: area.has-hover ? 1 : 0;
                icon: @image-url("icons/play.svg");
                size: 48px;
                fill: Theme.accent;
                tint: Theme.background;
                animate y, opacity { duration: 180ms; easing: ease-out; }
                clicked => { root.clicked(); }
            }
        }
        Text { text: root.song.title; color: root.song.playing ? Theme.accent : Theme.on-surface; font-weight: 600; overflow: elide; }
        Text { text: root.song.artist; color: Theme.muted; font-size: 13px; overflow: elide; }
    }
}

// ---------------------------------------------------------------- Pages

component PageTitle inherits Text {
    color: Theme.on-surface;
    font-size: 36px;
    font-weight: 800;
}

/// A compact tile: small artwork and the title, three to a row.
component QuickPick inherits Rectangle {
    in property <Song> song;
    callback clicked;
    height: 64px;
    horizontal-stretch: 1;
    min-width: 0;
    preferred-width: 100px;
    border-radius: 16px;
    clip: true;
    background: song.playing ? Theme.accent-container : area.has-hover ? Theme.surface-highest : Theme.surface-high;
    animate background { duration: 150ms; }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        spacing: 12px;
        padding-right: 12px;
        Rectangle {
            width: 64px;
            Artwork { art: root.song.art; width: 64px; height: 64px; corner: 0; }
            if root.song.playing: PlayingOverlay { width: 64px; height: 64px; corner: 0; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.song.title; color: Theme.on-surface; font-weight: 600; overflow: elide; }
            Text { text: root.song.artist; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
    }
}

/// A large card to carry on with the last song.
component JumpBackIn inherits Rectangle {
    in property <Song> song;
    callback clicked;
    height: 112px;
    border-radius: Theme.radius;
    background: @linear-gradient(90deg, Theme.accent-container 0%, Theme.surface-high 100%);
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 12px;
        padding-right: 24px;
        spacing: 16px;
        Artwork { art: root.song.art; width: 88px; height: 88px; corner: 18px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: "Jump back in"; color: Theme.accent; font-size: 13px; font-weight: 700; }
            Text { text: root.song.title; color: Theme.on-surface; font-size: 20px; font-weight: 700; overflow: elide; }
            Text { text: root.song.artist; color: Theme.muted; overflow: elide; }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/play.svg");
            size: 56px;
            fill: Theme.accent;
            tint: Theme.background;
            clicked => { root.clicked(); }
        }
    }
}

/// A genre tile with a slowly turning flower shape in the corner.
component GenreTile inherits Rectangle {
    in property <string> label;
    in property <color> tone;
    in property <bool> reverse;
    callback clicked;
    property <float> t: animation-tick() / 1ms / 1000;
    height: 96px;
    horizontal-stretch: 1;
    border-radius: 24px;
    clip: true;
    background: area.has-hover ? root.tone.brighter(0.15) : root.tone;
    animate background { duration: 150ms; }
    for i in 2: Rectangle {
        x: parent.width - 66px;
        y: 30px;
        width: 92px;
        height: 92px;
        border-radius: 30px;
        background: #ffffff1c;
        transform-rotation: (root.reverse ? -1 : 1) * root.t * 15deg + i * 45deg;
    }
    Text {
        x: 18px;
        y: 16px;
        text: root.label;
        color: #f2f0f7;
        font-size: 18px;
        font-weight: 800;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component HomePage inherits Rectangle {
    in property <SceneInfo> scene;
    in property <bool> ambience;
    in property <string> greeting;
    in property <string> line;
    in property <string> date-line;
    in property <string> moods-title;
    in property <[string]> moods;
    in property <[Song]> recent;
    in property <[Song]> picks-a;
    in property <[Song]> picks-b;
    in property <[Song]> liked;
    callback recent-action(int, SongAction);
    callback pick-action(int, SongAction);
    callback liked-action(int, SongAction);
    callback search-for(string);
    Flickable {
        content-width: self.width;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: root.width;
            // The greeting over the living sky.
            Rectangle {
                height: 290px;
                if root.ambience: AmbientScene {
                    width: 100%;
                    height: 100%;
                    info: root.scene;
                    fade-to: Theme.background;
                }
                VerticalLayout {
                    padding: 32px;
                    padding-bottom: 4px;
                    alignment: end;
                    Text { text: root.date-line; color: Theme.muted; font-size: 14px; font-weight: 600; }
                    PageTitle { text: root.greeting; font-size: 46px; }
                    Text { text: root.line; color: Theme.muted; font-size: 17px; }
                }
            }
            VerticalLayout {
                padding: 32px;
                padding-top: 20px;
                spacing: 16px;
                if root.recent.length > 0 && !root.recent[0].playing: JumpBackIn {
                    song: root.recent[0];
                    clicked => { root.recent-action(0, SongAction.play); }
                }
                if root.picks-a.length > 0: SectionTitle { text: "Quick picks"; }
                if root.picks-a.length > 0: HorizontalLayout {
                    spacing: 10px;
                    for song[i] in root.picks-a: QuickPick {
                        song: song;
                        clicked => { root.pick-action(i, SongAction.play); }
                    }
                }
                if root.picks-b.length > 0: HorizontalLayout {
                    spacing: 10px;
                    for song[i] in root.picks-b: QuickPick {
                        song: song;
                        clicked => { root.pick-action(i + 3, SongAction.play); }
                    }
                }
                if root.recent.length > 0: SectionTitle { text: "Recently played"; }
                if root.recent.length > 0: Flickable {
                    height: 240px;
                    content-width: recent-row.preferred-width;
                    recent-row := HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for song[i] in root.recent: SongCard {
                            song: song;
                            clicked => { root.recent-action(i, SongAction.play); }
                            action(a) => { root.recent-action(i, a); }
                        }
                    }
                }
                SectionTitle { text: root.moods-title; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for mood in root.moods: Chip {
                        label: mood;
                        clicked => { root.search-for(mood); }
                    }
                }
                SectionTitle { text: "Explore"; }
                HorizontalLayout {
                    spacing: 12px;
                    GenreTile { label: "Pop"; tone: #24485a; clicked => { root.search-for("pop hits"); } }
                    GenreTile { label: "Hip hop"; tone: #4d3d1f; reverse: true; clicked => { root.search-for("hip hop"); } }
                    GenreTile { label: "Rock"; tone: #522a2a; clicked => { root.search-for("rock classics"); } }
                    GenreTile { label: "Electronic"; tone: #27375e; reverse: true; clicked => { root.search-for("electronic dance"); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    GenreTile { label: "R&B"; tone: #5a2d45; reverse: true; clicked => { root.search-for("r&b soul"); } }
                    GenreTile { label: "Jazz"; tone: #3b2f63; clicked => { root.search-for("jazz classics"); } }
                    GenreTile { label: "Classical"; tone: #44402a; reverse: true; clicked => { root.search-for("classical music"); } }
                    GenreTile { label: "Lo-fi"; tone: #2a4a3a; clicked => { root.search-for("lofi beats"); } }
                }
                if root.liked.length > 0: SectionTitle { text: "Liked songs"; }
                if root.liked.length > 0: SongTable {
                    songs: root.liked;
                    action(i, a) => { root.liked-action(i, a); }
                }
                if root.recent.length == 0 && root.liked.length == 0: Text {
                    text: "Songs you play and like will show up here. Press Ctrl+F to search.";
                    color: Theme.muted;
                    font-size: 15px;
                }
            }
        }
    }
}

component SearchPage inherits Rectangle {
    in property <[Song]> results;
    in property <bool> searching;
    in property <bool> videos;
    in property <string> message;
    in property <int> focus-request;
    in property <string> query;
    callback search(string);
    callback show-videos(bool);
    callback action(int, SongAction);
    changed focus-request => { field.focus(); field.select-all(); }
    changed query => { field.text = root.query; }
    init => { field.text = root.query; field.focus(); }
    VerticalLayout {
        padding: 32px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 16px;
            PageTitle { text: "Search"; }
            Rectangle {
                height: 52px;
                y: (parent.height - self.height) / 2;
                horizontal-stretch: 1;
                border-radius: 26px;
                background: field.has-focus ? Theme.surface-highest : Theme.surface-high;
                border-width: field.has-focus ? 2px : 0;
                border-color: Theme.accent;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;
                    Icon { source: @image-url("icons/search.svg"); tint: Theme.muted; y: (parent.height - self.height) / 2; }
                    Rectangle {
                        horizontal-stretch: 1;
                        field := TextInput {
                            width: 100%;
                            font-size: 16px;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.search(self.text); }
                        }
                        Text {
                            visible: field.text == "";
                            x: 0;
                            text: "Songs, artists, videos";
                            font-size: 16px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: "Ctrl+F"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Chip { label: "Music"; selected: !root.videos; clicked => { root.show-videos(false); } }
            Chip { label: "Videos"; selected: root.videos; clicked => { root.show-videos(true); } }
            Rectangle { width: 12px; }
            if root.searching: Text { text: "Searching…"; color: Theme.muted; vertical-alignment: center; }
            if !root.searching && root.message != "": Text { text: root.message; color: Theme.muted; vertical-alignment: center; }
        }
        SongTable {
            songs: root.results;
            action(i, a) => { root.action(i, a); }
        }
    }
}

/// A text box with a confirm button, for naming playlists.
component NameField inherits Rectangle {
    in property <string> placeholder;
    in property <string> initial;
    in property <string> button: "Create";
    callback done(string);
    callback cancel();
    height: 52px;
    border-radius: 26px;
    background: Theme.surface-high;
    border-width: 2px;
    border-color: Theme.accent;
    init => {
        field.text = root.initial;
        field.focus();
        field.select-all();
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            field := TextInput {
                width: 100%;
                font-size: 16px;
                color: Theme.on-surface;
                vertical-alignment: center;
                single-line: true;
                accepted => { if (self.text != "") { root.done(self.text); } }
            }
            Text {
                visible: field.text == "";
                x: 0;
                text: root.placeholder;
                font-size: 16px;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
        Chip { y: (parent.height - self.height) / 2; label: root.button; selected: true; clicked => { if (field.text != "") { root.done(field.text); } } }
        Chip { y: (parent.height - self.height) / 2; label: "Cancel"; clicked => { root.cancel(); } }
    }
}

/// A playlist in a list: its cover, name and how many songs.
component PlaylistRow inherits Rectangle {
    in property <PlaylistItem> item;
    callback clicked;
    height: 72px;
    border-radius: 16px;
    background: area.has-hover ? Theme.surface-high : transparent;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 8px;
        spacing: 14px;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            clip: true;
            background: Theme.accent-container;
            if root.item.art.width == 0: Icon {
                source: @image-url("icons/queue_music.svg");
                tint: Theme.accent;
                width: 26px;
                height: 26px;
            }
            if root.item.art.width > 0: Image { source: root.item.art; width: 100%; height: 100%; image-fit: cover; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.item.name; color: Theme.on-surface; font-size: 16px; font-weight: 600; overflow: elide; }
            Text { text: root.item.count == 1 ? "1 song" : root.item.count + " songs"; color: Theme.muted; font-size: 13px; }
        }
    }
}

component LibraryPage inherits Rectangle {
    in property <[Song]> liked;
    in property <[Song]> recent;
    in property <[Song]> kept;
    in property <[PlaylistItem]> playlists;
    // The open playlist ("" when the list of playlists shows).
    in property <string> open-id;
    in property <string> open-name;
    in property <[Song]> open-songs;
    in property <int> list; // 0 liked, 1 recently played, 2 playlists, 3 kept
    callback show(int);
    // A song row's request, with the app's list number.
    callback action(int, int, SongAction);
    // A song dragged to a new place: list, from, to.
    callback reorder(int, int, int);
    callback open-playlist(string);
    callback close-playlist();
    callback new-playlist(string);
    callback rename-playlist(string);
    callback delete-playlist();
    callback play-playlist(bool);
    callback clear-history();
    property <bool> naming;
    property <bool> renaming;
    property <bool> confirm-delete;
    changed open-id => {
        root.renaming = false;
        root.confirm-delete = false;
    }
    VerticalLayout {
        padding: 32px;
        spacing: 16px;
        PageTitle { text: "Library"; }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Chip { label: "Liked · " + root.liked.length; selected: root.list == 0; clicked => { root.show(0); } }
            Chip { label: "Recently played · " + root.recent.length; selected: root.list == 1; clicked => { root.show(1); } }
            Chip { label: "Playlists · " + root.playlists.length; selected: root.list == 2; clicked => { root.show(2); } }
            Chip { label: "Kept on this computer · " + root.kept.length; selected: root.list == 3; clicked => { root.show(3); } }
        }
        if root.list == 0: SongTable {
            songs: root.liked;
            action(i, a) => { root.action(2, i, a); }
        }
        if root.list == 1 && root.recent.length > 0: HorizontalLayout {
            alignment: start;
            Chip { label: "Clear history"; clicked => { root.clear-history(); } }
        }
        if root.list == 1: SongTable {
            songs: root.recent;
            list-kind: 1;
            action(i, a) => { root.action(1, i, a); }
        }
        if root.list == 3: SongTable {
            songs: root.kept;
            list-kind: 3;
            action(i, a) => { root.action(3, i, a); }
        }
        // The playlists.
        if root.list == 2 && root.open-id == "" && !root.naming: HorizontalLayout {
            alignment: start;
            Chip { label: "New playlist"; icon: @image-url("icons/add.svg"); clicked => { root.naming = true; } }
        }
        if root.list == 2 && root.open-id == "" && root.naming: NameField {
            placeholder: "Playlist name";
            done(name) => {
                root.naming = false;
                root.new-playlist(name);
            }
            cancel => { root.naming = false; }
        }
        if root.list == 2 && root.open-id == "" && root.playlists.length == 0: Text {
            text: "No playlists yet. Make one here, or right-click any song and choose Add to playlist.";
            color: Theme.muted;
            wrap: word-wrap;
        }
        if root.list == 2 && root.open-id == "": ListView {
            for item in root.playlists: PlaylistRow {
                item: item;
                clicked => { root.open-playlist(item.id); }
            }
        }
        // One open playlist.
        if root.list == 2 && root.open-id != "": HorizontalLayout {
            spacing: 8px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/arrow_back.svg");
                clicked => { root.close-playlist(); }
            }
            if !root.renaming: Text {
                text: root.open-name;
                color: Theme.on-surface;
                font-size: 26px;
                font-weight: 800;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.renaming: NameField {
                horizontal-stretch: 1;
                initial: root.open-name;
                button: "Rename";
                done(name) => {
                    root.renaming = false;
                    root.rename-playlist(name);
                }
                cancel => { root.renaming = false; }
            }
        }
        if root.list == 2 && root.open-id != "": HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.open-songs.length > 0: Chip { label: "Play"; icon: @image-url("icons/play.svg"); selected: true; clicked => { root.play-playlist(false); } }
            if root.open-songs.length > 0: Chip { label: "Shuffle"; icon: @image-url("icons/shuffle.svg"); clicked => { root.play-playlist(true); } }
            Chip { label: "Rename"; clicked => { root.renaming = true; } }
            if !root.confirm-delete: Chip { label: "Delete"; clicked => { root.confirm-delete = true; } }
            if root.confirm-delete: Chip {
                label: "Delete this playlist?";
                selected: true;
                clicked => {
                    root.confirm-delete = false;
                    root.delete-playlist();
                }
            }
            if root.confirm-delete: Chip { label: "Keep it"; clicked => { root.confirm-delete = false; } }
        }
        if root.list == 2 && root.open-id != "" && root.open-songs.length == 0: Text {
            text: "Empty for now. Right-click any song and choose Add to playlist.";
            color: Theme.muted;
            wrap: word-wrap;
        }
        if root.list == 2 && root.open-id != "": SongTable {
            songs: root.open-songs;
            list-kind: 5;
            action(i, a) => { root.action(5, i, a); }
            reorder(from, to) => { root.reorder(5, from, to); }
        }
        if root.list == 2 && root.open-id == "" && root.playlists.length == 0: Rectangle { }
    }
}

component SettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in-out property <bool> checked;
    in property <bool> first;
    in property <bool> last;
    callback toggled(bool);
    height: 84px;
    border-top-left-radius: first ? Theme.radius : 4px;
    border-top-right-radius: first ? Theme.radius : 4px;
    border-bottom-left-radius: last ? Theme.radius : 4px;
    border-bottom-right-radius: last ? Theme.radius : 4px;
    background: Theme.surface-container;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Rectangle {
            width: 40px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: 20px;
            background: Theme.accent-container;
            Icon {
                source: root.icon;
                tint: Theme.accent;
                width: 22px;
                height: 22px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.on-surface;
                font-size: 16px;
            }
            Text {
                text: root.subtitle;
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        Switch {
            checked <=> root.checked;
            toggled => { root.toggled(self.checked); }
        }
    }
}

/// One choice out of a few, as chips.
component ChoiceRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> note;
    in property <[string]> options;
    // -1 is the first option ("Auto"), then 0, 1, 2...
    in-out property <int> selected;
    callback picked(int);
    height: 128px;
    border-radius: 4px;
    background: Theme.surface-container;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Theme.accent-container;
                Icon { source: root.icon; tint: Theme.accent; width: 22px; height: 22px; }
            }
            VerticalLayout {
                alignment: center;
                Text { text: root.title; color: Theme.on-surface; font-size: 16px; }
                Text { text: root.note; color: Theme.muted; font-size: 13px; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            padding-left: 56px;
            for option[i] in root.options: Chip {
                label: option;
                selected: root.selected == i - 1;
                clicked => {
                    root.selected = i - 1;
                    root.picked(i - 1);
                }
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    in-out property <bool> keep-songs;
    in-out property <bool> offline;
    in property <string> usage;
    in-out property <int> cache-limit;
    in-out property <int> theme-mode;
    callback theme-changed();
    in property <[BrickItem]> bricks;
    in property <string> brick-note;
    callback check-bricks();
    callback show-logs();
    callback set-cache-limit(int);
    callback clear-kept();
    property <bool> confirm-clear;
    in-out property <bool> amb-enabled;
    in-out property <int> amb-day;
    in-out property <int> amb-season;
    in-out property <bool> amb-southern;
    in-out property <bool> amb-special;
    in property <SceneInfo> scene;
    in property <string> scene-label;
    callback set-keep-songs(bool);
    callback set-offline(bool);
    callback ambience-changed();
    in-out property <bool> autoplay;
    callback set-autoplay(bool);
    Flickable {
        content-width: self.width;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: root.width;
            padding: 32px;
            spacing: 2px;
            Text {
                text: "Settings";
                color: Theme.on-surface;
                font-size: 40px;
                font-weight: 800;
            }
            Text {
                text: "Offline listening";
                color: Theme.accent;
                font-weight: 700;
                height: 48px;
                vertical-alignment: center;
            }
            SettingRow {
                first: true;
                icon: @image-url("icons/offline_pin.svg");
                title: "Keep songs for offline listening";
                subtitle: "Songs you play in full stay inside Veena, scrambled. They aren't downloads.";
                checked <=> root.keep-songs;
                toggled(on) => { root.set-keep-songs(on); }
            }
            SettingRow {
                icon: @image-url("icons/cloud_off.svg");
                title: "Offline mode";
                subtitle: "Only play songs kept on this computer.";
                checked <=> root.offline;
                toggled(on) => { root.set-offline(on); }
            }
            ChoiceRow {
                icon: @image-url("icons/storage.svg");
                title: "Space for kept songs";
                note: root.usage + ". The oldest go first when it's full.";
                options: ["512 MB", "1 GB", "2 GB", "4 GB", "8 GB"];
                selected: root.cache-limit - 1;
                picked(i) => {
                    root.cache-limit = i + 1;
                    root.set-cache-limit(i + 1);
                }
            }
            Rectangle {
                height: 72px;
                border-radius: 4px;
                border-bottom-left-radius: Theme.radius;
                border-bottom-right-radius: Theme.radius;
                background: Theme.surface-container;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.accent-container;
                        Icon {
                            source: @image-url("icons/delete.svg");
                            tint: Theme.accent;
                            width: 22px;
                            height: 22px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Remove all kept songs";
                            color: Theme.on-surface;
                            font-size: 16px;
                        }
                        Text {
                            text: "Frees the space. Liked songs and playlists stay.";
                            color: Theme.muted;
                            font-size: 13px;
                        }
                    }
                    if !root.confirm-clear: Chip { y: (parent.height - self.height) / 2; label: "Remove all"; clicked => { root.confirm-clear = true; } }
                    if root.confirm-clear: Chip {
                        y: (parent.height - self.height) / 2;
                        label: "Remove them?";
                        selected: true;
                        clicked => {
                            root.confirm-clear = false;
                            root.clear-kept();
                        }
                    }
                    if root.confirm-clear: Chip { y: (parent.height - self.height) / 2; label: "Cancel"; clicked => { root.confirm-clear = false; } }
                }
            }
            Text {
                text: "Playback";
                color: Theme.accent;
                font-weight: 700;
                height: 48px;
                vertical-alignment: center;
            }
            SettingRow {
                first: true;
                last: true;
                icon: @image-url("icons/queue_music.svg");
                title: "Autoplay similar songs";
                subtitle: "When the queue runs out, keep going with songs like the last one, picked using what you like and skip.";
                checked <=> root.autoplay;
                toggled(on) => { root.set-autoplay(on); }
            }
            Text {
                text: "Look";
                color: Theme.accent;
                font-weight: 700;
                height: 48px;
                vertical-alignment: center;
            }
            ChoiceRow {
                icon: @image-url("icons/palette.svg");
                title: "Theme";
                note: "System follows your desktop's light or dark setting.";
                options: ["System", "Light", "Dark"];
                selected: root.theme-mode - 1;
                picked(i) => {
                    root.theme-mode = i + 1;
                    root.theme-changed();
                }
            }
            Text {
                text: "Living background";
                color: Theme.accent;
                font-weight: 700;
                height: 48px;
                vertical-alignment: center;
            }
            SettingRow {
                first: true;
                last: !root.amb-enabled;
                icon: @image-url("icons/animation.svg");
                title: "Living background";
                subtitle: "An animated sky on Home that follows the clock and the calendar: sun, moon, stars and the seasons.";
                checked <=> root.amb-enabled;
                toggled => { root.ambience-changed(); }
            }
            if root.amb-enabled: Rectangle {
                height: 196px;
                border-radius: 4px;
                background: Theme.surface-container;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Rectangle {
                        border-radius: 20px;
                        clip: true;
                        AmbientScene { width: 100%; height: 100%; info: root.scene; fade: false; }
                    }
                    Text { text: root.scene-label; color: Theme.muted; font-size: 13px; font-weight: 600; }
                }
            }
            if root.amb-enabled: ChoiceRow {
                icon: @image-url("icons/twilight.svg");
                title: "Time of day";
                note: "Auto follows the clock.";
                options: ["Auto", "Dawn", "Day", "Dusk", "Night"];
                selected <=> root.amb-day;
                picked => { root.ambience-changed(); }
            }
            if root.amb-enabled: ChoiceRow {
                icon: @image-url("icons/eco.svg");
                title: "Season";
                note: "Auto follows the date.";
                options: ["Auto", "Spring", "Summer", "Autumn", "Winter"];
                selected <=> root.amb-season;
                picked => { root.ambience-changed(); }
            }
            if root.amb-enabled && root.amb-season == -1: SettingRow {
                icon: @image-url("icons/public.svg");
                title: "Southern hemisphere";
                subtitle: "Summer in December, winter in June.";
                checked <=> root.amb-southern;
                toggled => { root.ambience-changed(); }
            }
            if root.amb-enabled: SettingRow {
                last: true;
                icon: @image-url("icons/celebration.svg");
                title: "New Year";
                subtitle: "Fireworks in the sky on 31 December and 1 January.";
                checked <=> root.amb-special;
                toggled => { root.ambience-changed(); }
            }
            Text {
                text: "Bricks";
                color: Theme.accent;
                font-weight: 700;
                height: 48px;
                vertical-alignment: center;
            }
            Text {
                text: "The parts that fetch music and lyrics. They update on their own, without a new app.";
                color: Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
            }
            Rectangle { height: 10px; }
            for brick[i] in root.bricks: Rectangle {
                height: 64px;
                border-top-left-radius: i == 0 ? Theme.radius : 4px;
                border-top-right-radius: i == 0 ? Theme.radius : 4px;
                border-bottom-left-radius: 4px;
                border-bottom-right-radius: 4px;
                background: Theme.surface-container;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 20px;
                    spacing: 16px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 20px;
                        background: Theme.accent-container;
                        Icon {
                            source: brick.failed ? @image-url("icons/bug.svg") : @image-url("icons/extension.svg");
                            tint: Theme.accent;
                            width: 22px;
                            height: 22px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: brick.name; color: Theme.on-surface; font-size: 15px; }
                        Text { text: brick.detail; color: brick.failed ? #f2b8b5 : Theme.muted; font-size: 12px; overflow: elide; }
                    }
                    Text { text: brick.version; color: Theme.muted; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                }
            }
            Rectangle {
                height: 64px;
                border-radius: 4px;
                border-bottom-left-radius: Theme.radius;
                border-bottom-right-radius: Theme.radius;
                background: Theme.surface-container;
                HorizontalLayout {
                    padding-left: 72px;
                    padding-right: 16px;
                    spacing: 12px;
                    Text {
                        text: root.brick-note;
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Chip { y: (parent.height - self.height) / 2; label: "Check for updates"; clicked => { root.check-bricks(); } }
                }
            }
            Text {
                text: "Help";
                color: Theme.accent;
                font-weight: 700;
                height: 48px;
                vertical-alignment: center;
            }
            Rectangle {
                height: 72px;
                border-radius: Theme.radius;
                background: logs-area.has-hover ? Theme.surface-high : Theme.surface-container;
                logs-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-logs(); }
                }
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: Theme.accent-container;
                        Icon {
                            source: @image-url("icons/bug.svg");
                            tint: Theme.accent;
                            width: 22px;
                            height: 22px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Logs"; color: Theme.on-surface; font-size: 16px; }
                        Text { text: "What Veena did recently, to copy when something doesn't play."; color: Theme.muted; font-size: 13px; }
                    }
                }
            }
            Text {
                text: "© 2026 HarryL0L. Veena Music is free software under the GNU GPL, version 3 or later. Made with Slint.";
                color: Theme.muted;
                font-size: 12px;
                height: 40px;
                vertical-alignment: bottom;
                wrap: word-wrap;
            }
        }
    }
}

/// A Material 3 style seek bar: a thick filled track, a gap, and a tall
/// thumb that grows while held.
component SeekBar inherits Rectangle {
    in property <float> value;
    callback released(float);
    property <float> shown: area.pressed ? clamp(area.mouse-x / self.width, 0, 1) : root.value;
    height: 32px;
    // Played part
    Rectangle {
        x: 0;
        width: max(0px, root.width * root.shown - 6px);
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
    }
    // Still to come
    Rectangle {
        x: root.width * root.shown + 6px;
        width: max(0px, root.width - self.x);
        height: 12px;
        border-radius: 6px;
        background: Theme.accent-container;
    }
    // Thumb
    Rectangle {
        x: root.width * root.shown - self.width / 2;
        width: 4px;
        height: area.pressed ? 36px : 28px;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 150ms; }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.released(clamp(self.mouse-x / root.width, 0, 1));
            }
        }
    }
}

/// The current song large, with its lyrics following along.
/// Up to four recent covers in a grid, each slowly zooming and drifting.
component ArtMosaic inherits Rectangle {
    in property <[Song]> songs;
    property <float> t: animation-tick() / 1ms / 1000;
    property <int> count: min(4, songs.length);
    clip: true;
    for song[i] in root.songs: Rectangle {
        visible: i < root.count;
        // One cover fills the window; two sit side by side; three or four make a grid.
        property <bool> single: root.count == 1;
        property <int> tile-col: root.count == 2 ? i : mod(i, 2);
        property <int> tile-row: root.count <= 2 ? 0 : (i < 2 ? 0 : 1);
        property <int> cols: root.count == 1 ? 1 : 2;
        property <int> rows: root.count <= 2 ? 1 : 2;
        // The third of three spans the bottom row.
        property <bool> wide: root.count == 3 && i == 2;
        x: self.tile-col * root.width / self.cols;
        y: self.tile-row * root.height / self.rows;
        width: self.wide ? root.width : root.width / self.cols;
        height: root.height / self.rows;
        clip: true;
        Image {
            source: song.art;
            image-fit: cover;
            property <float> zoom: 1.12 + 0.08 * sin((root.t * 0.12 + i * 1.7) * 1rad);
            width: parent.width * self.zoom;
            height: parent.height * self.zoom;
            x: (parent.width - self.width) / 2 + sin((root.t * 0.09 + i * 2.3) * 1rad) * parent.width * 0.04;
            y: (parent.height - self.height) / 2 + cos((root.t * 0.07 + i * 1.1) * 1rad) * parent.height * 0.04;
        }
    }
}

/// The Veena mark with rings of sound going out from it.
component Resonance inherits Rectangle {
    property <float> t: animation-tick() / 1ms / 1000;
    background: @radial-gradient(circle, #1a2a4d 0%, #08101f 100%);
    for i in 3: Rectangle {
        // Each ring grows and fades over three seconds, a second apart.
        property <float> p: (root.t / 3 + i / 3.0) - floor(root.t / 3 + i / 3.0);
        width: 60px + self.p * 180px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 - 10px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: #ffb89c;
        opacity: (1 - self.p) * 0.7;
    }
    Image {
        source: @image-url("icons/veena-mark.svg");
        width: 96px;
        height: 96px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 - 14px;
    }
}

component SidePanel inherits Rectangle {
    in property <Song> song;
    in property <bool> has-song;
    in property <[LyricLine]> lyrics;
    in property <string> lyrics-note;
    // For the "ready to play" side when nothing is on.
    in property <SceneInfo> scene;
    in property <bool> ambience;
    in property <string> greeting;
    in property <[Song]> recent;
    in property <int> liked-count;
    in property <[string]> moods;
    callback like();
    callback resume();
    callback shuffle-liked();
    callback mood(string);
    width: 360px;
    border-radius: Theme.radius;
    clip: true;
    background: @linear-gradient(180deg, Theme.accent-container 0%, Theme.background 55%, Theme.background 100%);
    animate background { duration: 500ms; }
    // Nothing on: a window onto the sky, and quick ways to start.
    if !root.has-song: VerticalLayout {
        padding: 20px;
        spacing: 14px;
        Rectangle {
            height: 200px;
            border-radius: 24px;
            clip: true;
            background: Theme.surface-high;
            // Your recent songs' artwork, slowly drifting...
            if root.recent.length > 0: ArtMosaic { width: 100%; height: 100%; songs: root.recent; }
            // ...or, before there is any, the Veena mark sending out rings.
            if root.recent.length == 0: Resonance { width: 100%; height: 100%; }
            Rectangle {
                background: @linear-gradient(180deg, #00000000 40%, #000000aa 100%);
            }
            Text {
                x: 18px;
                y: parent.height - self.height - 14px;
                text: "Ready when you are";
                color: #ffffff;
                font-size: 20px;
                font-weight: 800;
            }
        }
        if root.recent.length > 0: Rectangle {
            height: 72px;
            border-radius: 20px;
            background: resume-area.has-hover ? Theme.surface-highest : Theme.surface-high;
            animate background { duration: 150ms; }
            resume-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.resume(); }
            }
            HorizontalLayout {
                padding: 8px;
                padding-right: 12px;
                spacing: 12px;
                Artwork { art: root.recent[0].art; width: 56px; height: 56px; corner: 14px; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: "Pick up where you left off"; color: Theme.accent; font-size: 12px; font-weight: 700; }
                    Text { text: root.recent[0].title; color: Theme.on-surface; font-weight: 600; overflow: elide; }
                    Text { text: root.recent[0].artist; color: Theme.muted; font-size: 12px; overflow: elide; }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/play.svg");
                    fill: Theme.accent;
                    tint: Theme.background;
                    clicked => { root.resume(); }
                }
            }
        }
        if root.liked-count > 0: Rectangle {
            height: 52px;
            border-radius: 26px;
            background: shuffle-area.has-hover ? Theme.accent.brighter(0.1) : Theme.accent;
            shuffle-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.shuffle-liked(); }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Icon { source: @image-url("icons/shuffle.svg"); tint: Theme.background; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Shuffle liked songs (" + root.liked-count + ")";
                    color: Theme.background;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        Text { text: "Something for now"; color: Theme.on-surface; font-weight: 700; }
        for mood[i] in root.moods: Rectangle {
            visible: i < 3;
            height: i < 3 ? 44px : 0;
            border-radius: 14px;
            background: mood-area.has-hover ? Theme.surface-highest : Theme.surface-container;
            mood-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.mood(mood); }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                Icon { source: @image-url("icons/search.svg"); tint: Theme.muted; width: 18px; height: 18px; y: (parent.height - self.height) / 2; }
                Text { text: mood; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
            }
        }
        Rectangle { }
        Text {
            text: "Space play/pause · Ctrl+F search · ←/→ seek · Ctrl+←/→ previous/next";
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    // Something on: the cover sized to the panel's height, and lyrics in
    // the rest. On short windows (high display scaling, small screens) the
    // cover shrinks, then becomes a small row beside the title, so the
    // lyrics always show. Switching between the two is one smooth motion:
    // the cover shrinks into the thumbnail, the title slides beside it and
    // the lyrics card grows into the space.
    in-out property <bool> lyrics-expanded;
    property <length> inner: root.width - 48px;
    property <length> big-art: min(312px, root.height - 48px - 52px - 28px - 220px);
    // Expanding only counts while there are lyrics: a next song without any
    // brings the cover back (and its button) instead of a dead end.
    property <bool> compact: (root.lyrics-expanded && root.lyrics.length > 0) || self.big-art < 150px;
    // 0: big cover, 1: compact row; everything below moves with it.
    property <float> t: root.compact ? 1 : 0;
    animate t { duration: 320ms; easing: ease-in-out; }
    property <length> art: root.big-art * (1 - root.t) + 64px * root.t;
    property <length> art-x: 24px + (root.inner - root.big-art) / 2 * (1 - root.t);
    // The title: under the cover, or beside the thumbnail.
    // Follows the cover's real edge while it shrinks, so they never overlap.
    property <length> title-x: 24px * (1 - root.t) + (root.art-x + root.art + 12px) * root.t;
    property <length> title-y: (24px + root.art + 14px) * (1 - root.t) + (24px + root.art / 2 - 26px) * root.t;
    // The title and heart fade out mid-way and back in at their new place,
    // so they never cross the moving cover.
    property <float> title-fade: max(0, min(1, (abs(root.t - 0.5) - 0.15) / 0.35));
    property <length> card-y: (24px + root.big-art + 14px + 52px + 14px) * (1 - root.t) + (24px + 64px + 14px) * root.t;
    if root.has-song: Artwork {
        x: root.art-x;
        y: 24px;
        width: root.art;
        height: root.art;
        art: root.song.art;
        corner: 28px * (1 - root.t) + 16px * root.t;
        drop-shadow-blur: 24px * (1 - root.t);
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 8px * (1 - root.t);
    }
    if root.has-song: VerticalLayout {
        x: root.title-x;
        y: root.title-y;
        width: root.width - self.x - 24px - 44px;
        height: 52px;
        alignment: center;
        opacity: root.title-fade;
        Text { text: root.song.title; color: Theme.on-surface; font-size: 20px - 3px * root.t; font-weight: 800; overflow: elide; }
        Text { text: root.song.artist; color: Theme.muted; overflow: elide; }
    }
    if root.has-song: IconButton {
        opacity: root.title-fade;
        x: root.width - 24px - self.width;
        y: root.title-y + (52px - self.height) / 2;
        icon: root.song.liked ? @image-url("icons/favorite.svg") : @image-url("icons/favorite_border.svg");
        tint: root.song.liked ? Theme.accent : Theme.on-surface;
        clicked => { root.like(); }
    }
    if root.has-song: Rectangle {
        // A new song starts at the top of its lyrics.
        property <string> track: root.song.title + "\n" + root.song.artist;
        changed track => { lyrics-scroll.content-y = 0; }
        x: 24px;
        y: root.card-y;
        width: root.inner;
        height: root.height - root.card-y - 24px;
        border-radius: 24px;
        clip: true;
        background: Theme.accent-container.transparentize(0.55);
        VerticalLayout {
            padding: 20px;
            padding-top: 12px;
            padding-bottom: 0;
            spacing: 4px;
            HorizontalLayout {
                height: 40px;
                Text { text: "Lyrics"; color: Theme.on-surface; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                // Lyrics over the cover for full-height reading, and back.
                if root.lyrics.length > 0: IconButton {
                    y: (parent.height - self.height) / 2;
                    // Up: lyrics take over the panel. Down: the cover comes back.
                    icon: root.lyrics-expanded ? @image-url("icons/expand_more.svg") : @image-url("icons/expand_less.svg");
                    tint: Theme.on-surface;
                    clicked => { root.lyrics-expanded = !root.lyrics-expanded; }
                }
            }
            if root.lyrics.length == 0: Text { text: root.lyrics-note; color: Theme.muted; wrap: word-wrap; }
            // Scrolls on its own and glides to the line being sung. The
            // box takes its size from the card, so the list can't push it.
            Rectangle {
                vertical-stretch: 1;
                lyrics-scroll := Flickable {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    content-width: self.width;
                    content-height: lyric-lines.preferred-height;
                    animate content-y { duration: 450ms; easing: ease-in-out; }
                    lyric-lines := VerticalLayout {
                        width: lyrics-scroll.width;
                        spacing: 8px;
                        // Room below the last line, so it can reach the reading spot too.
                        padding-bottom: 240px;
                        for line in root.lyrics: Text {
                            property <int> sung: line.state;
                            property <bool> by-word: line.state == 0 && line.words;
                            text: line.text;
                            wrap: word-wrap;
                            font-size: line.state == 0 ? 20px : 15px;
                            font-weight: line.state == 0 ? 700 : 600;
                            // Word by word, the words colour in as they're sung,
                            // drawn over this (now invisible) line.
                            color: self.by-word ? transparent : line.state == 0 ? Theme.accent : line.state < 0 ? Theme.on-surface.transparentize(0.4) : Theme.on-surface.transparentize(0.65);
                            animate font-size, color { duration: 250ms; easing: ease-out; }
                            if self.by-word: StyledText {
                                width: parent.width;
                                height: parent.height;
                                // Follows the line's growing size, so both wrap alike.
                                default-font-size: parent.font-size;
                                default-color: Theme.accent;
                                text: @markdown("**<font color=\"\{Theme.accent}\">\{line.sung}</font><font color=\"\{Theme.accent.transparentize(0.6)}\">\{line.rest}</font>**");
                            }
                            changed sung => { self.follow(); }
                            // Lyrics that arrive mid-song start at the current line.
                            init => { self.follow(); }
                            function follow() {
                                if (self.sung == 0) {
                                    lyrics-scroll.content-y = min(0px, max(lyrics-scroll.height - lyric-lines.preferred-height, lyrics-scroll.height * 0.3 - self.y));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Recent log lines, selectable, to copy when something goes wrong.
component LogsDialog inherits Rectangle {
    in property <string> text;
    callback refresh();
    callback close();
    background: #000000a0;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(860px, root.width - 64px);
        height: root.height - 96px;
        border-radius: 28px;
        background: Theme.surface-container;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        TouchArea { }
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: "Logs"; color: Theme.on-surface; font-size: 24px; font-weight: 800; }
            Text { text: "What Veena did recently. Copy this when something doesn't play."; color: Theme.muted; font-size: 14px; }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 16px;
                background: Theme.surface-highest;
                clip: true;
                log-scroll := Flickable {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: parent.height - 24px;
                    content-height: log-text.preferred-height;
                    content-width: max(self.width, log-text.preferred-width);
                    log-text := TextInput {
                        text: root.text == "" ? "Nothing yet." : root.text;
                        read-only: true;
                        single-line: false;
                        font-family: "monospace";
                        font-size: 12px;
                        color: Theme.on-surface;
                    }
                    init => { self.content-y = min(0px, self.height - log-text.preferred-height); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Chip { label: "Refresh"; clicked => { root.refresh(); } }
                Chip {
                    label: "Copy all";
                    selected: true;
                    clicked => {
                        log-text.select-all();
                        log-text.copy();
                    }
                }
                Chip { label: "Close"; clicked => { root.close(); } }
            }
        }
    }
}

/// One choice in a small pop-up menu.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    callback clicked;
    height: 40px;
    border-radius: 12px;
    background: area.has-hover ? Theme.surface-highest : transparent;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 14px;
        text: root.label;
        color: root.current ? Theme.accent : Theme.on-surface;
        font-size: 14px;
        font-weight: root.current ? 700 : 400;
        vertical-alignment: center;
        height: parent.height;
    }
}

/// The player bar along the bottom, as on desktop music apps.
/// A song in the queue.
component QueueRow inherits Rectangle {
    in property <Song> song;
    in property <int> number;
    in property <int> count;
    in property <bool> current;
    in property <bool> lifted;
    in property <int> drop-line: -1;
    callback action(SongAction);
    callback drag-moved(length);
    callback drag-dropped();
    height: 64px;
    border-radius: 16px;
    // The row's own buttons count as the row, so they don't vanish under the pointer.
    property <bool> hovered: area.has-hover || remove.hovered || handle.active;
    background: root.lifted ? Theme.accent-container : root.current ? Theme.accent-container : root.hovered ? Theme.surface-high : transparent;
    border-width: root.lifted ? 2px : 0;
    border-color: Theme.accent;
    ContextMenuArea {
        Menu {
            MenuItem { title: "Play"; activated => { root.action(SongAction.play); } }
            MenuItem { title: root.song.liked ? "Remove from liked" : "Like"; activated => { root.action(SongAction.like); } }
            MenuItem { title: "Add to playlist…"; activated => { root.action(SongAction.add-to-playlist); } }
            MenuSeparator { }
            MenuItem { title: "Move up"; enabled: root.number > 0; activated => { root.action(SongAction.move-up); } }
            MenuItem { title: "Move down"; enabled: root.number < root.count - 1; activated => { root.action(SongAction.move-down); } }
            MenuItem { title: "Remove from queue"; enabled: !root.current; activated => { root.action(SongAction.remove-from-queue); } }
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.action(SongAction.play); }
        }
    }
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        Rectangle {
            width: 48px;
            height: 48px;
            Artwork { art: root.song.art; width: 48px; height: 48px; corner: 12px; }
            if root.current: PlayingOverlay { width: 48px; height: 48px; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.song.title; color: root.current ? Theme.accent : Theme.on-surface; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.song.artist; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        remove := IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/delete.svg");
            size: 32px;
            icon-size: 18px;
            visible: root.hovered && !root.current && !root.lifted;
            clicked => { root.action(SongAction.remove-from-queue); }
        }
        handle := DragHandle {
            y: (parent.height - self.height) / 2;
            opacity: root.hovered || root.lifted ? 1 : 0;
            moved(dy) => { root.drag-moved(dy); }
            dropped => { root.drag-dropped(); }
        }
    }
    if root.drop-line >= 0: DropLine {
        x: 8px;
        width: root.width - 16px;
        y: root.drop-line == 0 ? -1px : root.height - 2px;
    }
}

/// The right-hand panel's other side: what plays now and next.
component QueuePanel inherits Rectangle {
    in property <[Song]> queue;
    in property <int> current;
    callback action(int, SongAction);
    callback reorder(int, int);
    callback show-now-playing();
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    width: 360px;
    border-radius: Theme.radius;
    clip: true;
    background: Theme.background;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            padding-left: 8px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: "Up next"; color: Theme.on-surface; font-size: 22px; font-weight: 800; }
                Text {
                    text: root.queue.length == 0 ? "Nothing queued" : (root.queue.length - root.current - 1) + " after this one";
                    color: Theme.muted;
                    font-size: 13px;
                }
            }
            Chip { y: (parent.height - self.height) / 2; label: "Now playing"; clicked => { root.show-now-playing(); } }
        }
        if root.queue.length == 0: Text {
            text: "Play something, or right-click a song and choose Add to queue.";
            color: Theme.muted;
            wrap: word-wrap;
        }
        ListView {
            for song[i] in root.queue: QueueRow {
                song: song;
                number: i;
                count: root.queue.length;
                current: i == root.current;
                lifted: root.drag-from == i;
                drop-line: root.drag-from >= 0 && root.drag-to == i && i != root.drag-from ? (i < root.drag-from ? 0 : 1) : -1;
                action(a) => { root.action(i, a); }
                drag-moved(dy) => {
                    root.drag-from = i;
                    root.drag-to = max(0, min(root.queue.length - 1, i + round(dy / self.height)));
                }
                drag-dropped => {
                    if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                        root.reorder(root.drag-from, root.drag-to);
                    }
                    root.drag-from = -1;
                    root.drag-to = -1;
                }
            }
        }
    }
}

/// Pick a playlist for a song, or start a new one with it.
component PlaylistPicker inherits Rectangle {
    in property <string> song-title;
    in property <[PlaylistItem]> playlists;
    callback picked(string);
    callback create(string);
    callback close();
    property <bool> naming: root.playlists.length == 0;
    background: #000000a0;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(440px, root.width - 48px);
        height: min(root.height - 80px, 180px + max(1, root.playlists.length) * 72px);
        border-radius: 28px;
        background: Theme.surface-container;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        // Clicks inside stay inside.
        TouchArea { }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: "Add to playlist"; color: Theme.on-surface; font-size: 22px; font-weight: 800; }
            Text { text: root.song-title; color: Theme.muted; font-size: 14px; overflow: elide; }
            if !root.naming: HorizontalLayout {
                alignment: start;
                Chip { label: "New playlist"; icon: @image-url("icons/add.svg"); clicked => { root.naming = true; } }
            }
            if root.naming: NameField {
                placeholder: "Playlist name";
                done(name) => { root.create(name); }
                cancel => {
                    if (root.playlists.length == 0) {
                        root.close();
                    } else {
                        root.naming = false;
                    }
                }
            }
            ListView {
                for item in root.playlists: PlaylistRow {
                    item: item;
                    clicked => { root.picked(item.id); }
                }
            }
        }
    }
}

component PlayerBar inherits Rectangle {
    in property <Song> song;
    in property <bool> has-song;
    in property <bool> playing;
    in property <bool> loading;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> progress;
    in property <string> position;
    in property <string> duration;
    in property <float> volume;
    in property <bool> panel-open;
    // 0 now playing, 1 up next
    in property <int> panel-mode;
    // "" without a sleep timer, else when it stops.
    in property <string> sleep-label;
    callback set-sleep(int);
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback like();
    callback set-volume(float);
    callback toggle-panel();
    callback toggle-queue();
    height: 92px;
    border-radius: Theme.radius;
    background: Theme.surface-container;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 20px;
        spacing: 16px;
        // The song
        HorizontalLayout {
            width: 300px;
            spacing: 12px;
            Artwork { art: root.song.art; width: 64px; height: 64px; y: (parent.height - self.height) / 2; corner: 14px; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.has-song ? root.song.title : "Nothing playing"; color: Theme.on-surface; font-weight: 700; overflow: elide; }
                Text { text: root.song.artist; color: Theme.muted; font-size: 13px; overflow: elide; }
            }
            if root.has-song: IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.song.liked ? @image-url("icons/favorite.svg") : @image-url("icons/favorite_border.svg");
                tint: root.song.liked ? Theme.accent : Theme.muted;
                size: 36px;
                icon-size: 20px;
                clicked => { root.like(); }
            }
        }
        // Controls and seek bar
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/shuffle.svg");
                    size: 36px;
                    icon-size: 20px;
                    tint: root.shuffle ? Theme.accent : Theme.muted;
                    clicked => { root.toggle-shuffle(); }
                }
                IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/skip_previous.svg"); clicked => { root.previous(); } }
                // Round while paused, a rounded square while playing.
                IconButton {
                    icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                    size: 48px;
                    corner: root.playing ? 14px : 24px;
                    fill: Theme.accent;
                    tint: Theme.background;
                    clicked => { root.toggle(); }
                }
                IconButton { y: (parent.height - self.height) / 2; icon: @image-url("icons/skip_next.svg"); clicked => { root.next(); } }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: root.repeat == 2 ? @image-url("icons/repeat_one.svg") : @image-url("icons/repeat.svg");
                    size: 36px;
                    icon-size: 20px;
                    tint: root.repeat > 0 ? Theme.accent : Theme.muted;
                    clicked => { root.cycle-repeat(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.position; color: Theme.muted; font-size: 12px; width: 44px; horizontal-alignment: right; vertical-alignment: center; }
                SeekBar { value: root.progress; released(v) => { root.seek(v); } height: 20px; }
                Text { text: root.loading ? "…" : root.duration; color: Theme.muted; font-size: 12px; width: 44px; vertical-alignment: center; }
            }
        }
        // Sleep timer, panels and volume
        HorizontalLayout {
            width: 350px;
            spacing: 8px;
            alignment: end;
            if root.sleep-label != "": Text {
                text: root.sleep-label;
                color: Theme.accent;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            sleep-button := IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/bedtime.svg");
                fill: root.sleep-label != "" ? Theme.accent-container : transparent;
                tint: root.sleep-label != "" ? Theme.accent : Theme.muted;
                clicked => { sleep-menu.show(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/library_music.svg");
                fill: root.panel-open && root.panel-mode == 0 ? Theme.accent-container : transparent;
                tint: root.panel-open && root.panel-mode == 0 ? Theme.accent : Theme.muted;
                clicked => { root.toggle-panel(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/queue_music.svg");
                fill: root.panel-open && root.panel-mode == 1 ? Theme.accent-container : transparent;
                tint: root.panel-open && root.panel-mode == 1 ? Theme.accent : Theme.muted;
                clicked => { root.toggle-queue(); }
            }
            Icon { source: @image-url("icons/music_note.svg"); tint: Theme.muted; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
            SeekBar {
                width: 120px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                value: root.volume;
                released(v) => { root.set-volume(v); }
            }
        }
    }
    sleep-menu := PopupWindow {
        x: root.width - 420px;
        y: -self.height - 8px;
        width: 220px;
        height: menu-col.preferred-height;
        Rectangle {
            border-radius: 20px;
            background: Theme.surface-high;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
        }
        menu-col := VerticalLayout {
            padding: 8px;
            HorizontalLayout {
                padding-left: 14px;
                Text {
                    text: "Sleep timer";
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 700;
                    height: 32px;
                    vertical-alignment: center;
                }
            }
            MenuRow { label: "15 minutes"; clicked => { root.set-sleep(15); } }
            MenuRow { label: "30 minutes"; clicked => { root.set-sleep(30); } }
            MenuRow { label: "45 minutes"; clicked => { root.set-sleep(45); } }
            MenuRow { label: "1 hour"; clicked => { root.set-sleep(60); } }
            MenuRow { label: "End of this song"; clicked => { root.set-sleep(0); } }
            if root.sleep-label != "": MenuRow { label: "Turn off"; current: true; clicked => { root.set-sleep(-1); } }
        }
    }
}

// ---------------------------------------------------------------- Window

export component AppWindow inherits Window {
    title: "Veena Music";
    icon: @image-url("icons/veena.svg");
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 600px;
    // One base colour; the panes float on it.
    background: Theme.surface;
    default-font-family: "Inter";

    in-out property <int> page; // 0 home, 1 search, 2 library, 3 settings
    in property <string> greeting: "Welcome back";
    in property <[Song]> recent;
    // The whole history, for the Library (recent is only the latest few).
    in property <[Song]> recent-all;
    in property <[Song]> liked;
    in property <[Song]> kept;
    in property <[Song]> results;
    in property <bool> searching;
    in property <string> search-message;
    in-out property <bool> videos;
    in-out property <int> library-list;
    in property <[PlaylistItem]> playlists;
    in property <string> open-playlist-id;
    in property <string> open-playlist-name;
    in property <[Song]> open-playlist-songs;
    in property <[Song]> queue;
    in property <int> queue-current: -1;
    // 0 now playing, 1 up next
    in-out property <int> panel-mode;
    // The song waiting for a playlist ("" when the picker is closed).
    in property <string> picking-for;
    // Index into 512 MB, 1, 2, 4, 8 GB.
    in-out property <int> cache-limit: 1;
    // 0 follows the desktop, 1 light, 2 dark.
    in-out property <int> theme-mode;
    in property <bool> system-dark: true;
    property <bool> dark: root.theme-mode == 2 || (root.theme-mode == 0 && root.system-dark);
    changed dark => { root.apply-theme(); }
    init => { root.apply-theme(); }
    function apply-theme() {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    in property <string> sleep-label;
    in property <[BrickItem]> bricks;
    in property <string> brick-note;
    in property <string> logs;
    in-out property <bool> logs-open;
    in-out property <bool> keep-songs: true;
    in-out property <bool> offline;
    in property <string> usage;
    in property <SceneInfo> scene;
    in property <string> scene-label;
    in property <string> home-line;
    in property <string> date-line;
    in property <string> moods-title: "Moods";
    in property <[string]> moods;
    in property <[Song]> picks-a;
    in property <[Song]> picks-b;
    in property <string> search-text;
    in-out property <bool> amb-enabled: true;
    in-out property <int> amb-day: -1;
    in-out property <int> amb-season: -1;
    in-out property <bool> amb-southern;
    in-out property <bool> amb-special: true;
    in-out property <bool> autoplay: true;
    in-out property <bool> lyrics-expanded;
    in-out property <bool> panel-open: true;
    in-out property <int> search-focus;

    in property <Song> now;
    in property <bool> has-song;
    in property <bool> playing;
    in property <bool> loading;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> progress;
    in property <string> position: "0:00";
    in property <string> duration: "";
    in-out property <float> volume: 1.0;
    in property <[LyricLine]> lyrics;
    in property <string> lyrics-note: "No lyrics found for this song.";

    /// A song row's request. Lists: 0 search results, 1 recently played,
    /// 2 liked, 3 kept on this computer, 4 quick picks, 5 the open
    /// playlist, 6 the queue.
    callback song-action(int, int, SongAction);
    callback search(string);
    callback show-videos(bool);
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback seek-by(int);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback like-now();
    callback set-volume(float);
    callback set-keep-songs(bool);
    callback set-offline(bool);
    callback ambience-changed();
    callback set-autoplay(bool);
    callback shuffle-liked();
    callback open-playlist(string);
    callback close-playlist();
    callback new-playlist(string);
    callback rename-playlist(string);
    callback delete-playlist();
    callback play-playlist(bool);
    callback pick-playlist(string);
    callback pick-new-playlist(string);
    callback close-picker();
    callback clear-history();
    callback set-cache-limit(int);
    callback clear-kept();
    /// A song dragged to a new place in a list (5 the open playlist, 6 the queue).
    callback reorder(int, int, int);
    callback theme-changed();
    callback set-sleep(int);
    callback check-bricks();
    callback refresh-logs();

    // Keyboard shortcuts. Keys typed into the search field go there first.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle();
                return accept;
            }
            if (event.modifiers.control && event.text == "f") {
                root.page = 1;
                root.search-focus += 1;
                return accept;
            }
            if (event.modifiers.control && event.text == Key.RightArrow) { root.next(); return accept; }
            if (event.modifiers.control && event.text == Key.LeftArrow) { root.previous(); return accept; }
            if (event.modifiers.control && event.text == Key.UpArrow) { root.set-volume(min(1.0, root.volume + 0.1)); return accept; }
            if (event.modifiers.control && event.text == Key.DownArrow) { root.set-volume(max(0.0, root.volume - 0.1)); return accept; }
            if (event.text == Key.RightArrow) { root.seek-by(5000); return accept; }
            if (event.text == Key.LeftArrow) { root.seek-by(-5000); return accept; }
            reject
        }

        // Placed explicitly, so the window doesn't size itself from its own
        // contents (a layout loop).
        VerticalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding: 12px;
            padding-left: 0;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                // Navigation rail
                VerticalLayout {
                    width: 96px;
                    padding-top: 12px;
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 14px;
                            clip: true;
                            Image { source: @image-url("icons/veena.svg"); width: 100%; height: 100%; }
                        }
                    }
                    Rectangle { height: 8px; }
                    HorizontalLayout { alignment: center; NavItem { icon: @image-url("icons/home.svg"); label: "Home"; selected: root.page == 0; clicked => { root.page = 0; } } }
                    HorizontalLayout { alignment: center; NavItem { icon: @image-url("icons/search.svg"); label: "Search"; selected: root.page == 1; clicked => { root.page = 1; root.search-focus += 1; } } }
                    HorizontalLayout { alignment: center; NavItem { icon: @image-url("icons/library_music.svg"); label: "Library"; selected: root.page == 2; clicked => { root.page = 2; } } }
                    HorizontalLayout { alignment: center; NavItem { icon: @image-url("icons/settings.svg"); label: "Settings"; selected: root.page == 3; clicked => { root.page = 3; } } }
                }

                // Page
                Rectangle {
                    background: Theme.background;
                    border-radius: Theme.radius;
                    clip: true;
                    if root.page == 0: HomePage {
                        scene: root.scene;
                        ambience: root.amb-enabled;
                        greeting: root.greeting;
                        line: root.home-line;
                        date-line: root.date-line;
                        moods-title: root.moods-title;
                        moods: root.moods;
                        recent: root.recent;
                        picks-a: root.picks-a;
                        picks-b: root.picks-b;
                        liked: root.liked;
                        recent-action(i, a) => { root.song-action(1, i, a); }
                        pick-action(i, a) => { root.song-action(4, i, a); }
                        liked-action(i, a) => { root.song-action(2, i, a); }
                        search-for(q) => { root.search(q); }
                    }
                    if root.page == 1: SearchPage {
                        results: root.results;
                        searching: root.searching;
                        videos: root.videos;
                        message: root.search-message;
                        focus-request: root.search-focus;
                        query: root.search-text;
                        search(q) => { root.search(q); }
                        show-videos(v) => { root.show-videos(v); }
                        action(i, a) => { root.song-action(0, i, a); }
                    }
                    if root.page == 2: LibraryPage {
                        liked: root.liked;
                        recent: root.recent-all;
                        kept: root.kept;
                        playlists: root.playlists;
                        open-id: root.open-playlist-id;
                        open-name: root.open-playlist-name;
                        open-songs: root.open-playlist-songs;
                        list: root.library-list;
                        show(l) => { root.library-list = l; }
                        action(l, i, a) => { root.song-action(l, i, a); }
                        reorder(l, from, to) => { root.reorder(l, from, to); }
                        open-playlist(id) => { root.open-playlist(id); }
                        close-playlist => { root.close-playlist(); }
                        new-playlist(name) => { root.new-playlist(name); }
                        rename-playlist(name) => { root.rename-playlist(name); }
                        delete-playlist => { root.delete-playlist(); }
                        play-playlist(s) => { root.play-playlist(s); }
                        clear-history => { root.clear-history(); }
                    }
                    if root.page == 3: SettingsPage {
                        keep-songs <=> root.keep-songs;
                        offline <=> root.offline;
                        usage: root.usage;
                        cache-limit <=> root.cache-limit;
                        theme-mode <=> root.theme-mode;
                        theme-changed => { root.theme-changed(); }
                        bricks: root.bricks;
                        brick-note: root.brick-note;
                        check-bricks => { root.check-bricks(); }
                        show-logs => {
                            root.refresh-logs();
                            root.logs-open = true;
                        }
                        set-cache-limit(i) => { root.set-cache-limit(i); }
                        clear-kept => { root.clear-kept(); }
                        amb-enabled <=> root.amb-enabled;
                        amb-day <=> root.amb-day;
                        amb-season <=> root.amb-season;
                        amb-southern <=> root.amb-southern;
                        amb-special <=> root.amb-special;
                        scene: root.scene;
                        scene-label: root.scene-label;
                        set-keep-songs(on) => { root.set-keep-songs(on); }
                        set-offline(on) => { root.set-offline(on); }
                        ambience-changed => { root.ambience-changed(); }
                        autoplay <=> root.autoplay;
                        set-autoplay(on) => { root.set-autoplay(on); }
                    }
                }

                // Hidden on narrow windows so the page keeps its room.
                if root.panel-open && root.panel-mode == 1 && root.width > 1180px: QueuePanel {
                    queue: root.queue;
                    current: root.queue-current;
                    action(i, a) => { root.song-action(6, i, a); }
                    reorder(from, to) => { root.reorder(6, from, to); }
                    show-now-playing => { root.panel-mode = 0; }
                }
                if root.panel-open && root.panel-mode == 0 && root.width > 1180px: SidePanel {
                    song: root.now;
                    has-song: root.has-song;
                    lyrics: root.lyrics;
                    lyrics-note: root.lyrics-note;
                    scene: root.scene;
                    ambience: root.amb-enabled;
                    greeting: root.greeting;
                    recent: root.recent;
                    liked-count: root.liked.length;
                    moods: root.moods;
                    lyrics-expanded <=> root.lyrics-expanded;
                    like => { root.like-now(); }
                    resume => { root.song-action(1, 0, SongAction.play); }
                    shuffle-liked => { root.shuffle-liked(); }
                    mood(q) => { root.search(q); }
                }
            }

            HorizontalLayout {
                padding-left: 12px;
                PlayerBar {
                    song: root.now;
                    has-song: root.has-song;
                    playing: root.playing;
                    loading: root.loading;
                    shuffle: root.shuffle;
                    repeat: root.repeat;
                    progress: root.progress;
                    position: root.position;
                    duration: root.duration;
                    volume: root.volume;
                    panel-open: root.panel-open;
                    panel-mode: root.panel-mode;
                    sleep-label: root.sleep-label;
                    set-sleep(m) => { root.set-sleep(m); }
                    toggle => { root.toggle(); }
                    next => { root.next(); }
                    previous => { root.previous(); }
                    seek(v) => { root.seek(v); }
                    toggle-shuffle => { root.toggle-shuffle(); }
                    cycle-repeat => { root.cycle-repeat(); }
                    like => { root.like-now(); }
                    set-volume(v) => { root.set-volume(v); }
                    toggle-panel => {
                        root.panel-open = !(root.panel-open && root.panel-mode == 0);
                        root.panel-mode = 0;
                    }
                    toggle-queue => {
                        root.panel-open = !(root.panel-open && root.panel-mode == 1);
                        root.panel-mode = 1;
                    }
                }
            }
        }
    }
    if root.logs-open: LogsDialog {
        width: root.width;
        height: root.height;
        text: root.logs;
        refresh => { root.refresh-logs(); }
        close => { root.logs-open = false; }
    }
    if root.picking-for != "": PlaylistPicker {
        width: root.width;
        height: root.height;
        song-title: root.picking-for;
        playlists: root.playlists;
        picked(id) => { root.pick-playlist(id); }
        create(name) => { root.pick-new-playlist(name); }
        close => { root.close-picker(); }
    }
}
