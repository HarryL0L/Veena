// The living background: a sky that follows the time of day, the season's
// particles and special-day decorations. The app works out the sky's colours
// and where the sun and moon are; everything that moves is drawn here from
// one clock, with fixed pseudo-random numbers for each particle.

export struct SceneInfo {
    sky-top: color,
    sky-bottom: color,
    // 1 at night, 0 by day
    night: float,
    // highest at sunrise and sunset
    gold: float,
    sun-x: float,
    sun-y: float,
    sun-alpha: float,
    sun-color: color,
    moon-x: float,
    moon-y: float,
    moon-alpha: float,
    // 0 spring, 1 summer, 2 autumn, 3 winter
    season: int,
    // 0 none, 1 Diwali, 2 New Year, 3 Valentine's Day
    occasion: int,
}

global Rand {
    // A fixed number between 0 and 1 for each input.
    pure public function hash(n: float) -> float {
        return sin(n * 12.9898rad) * 43758.5453 - floor(sin(n * 12.9898rad) * 43758.5453);
    }
    pure public function wrap(v: float, m: float) -> float {
        return v - floor(v / m) * m;
    }
}

// A particle that falls (or rises, with a negative clock), sways and wraps.
component Faller inherits Rectangle {
    in property <int> n;
    in property <float> t;
    in property <length> area-width;
    in property <length> area-height;
    in property <float> speed: 20;
    in property <float> sway: 10;
    in property <float> drift: 0;
    property <float> h: area-height / 1px + 32;
    property <float> w: area-width / 1px + 32;
    property <float> v: speed * (0.6 + 0.8 * Rand.hash(n + 2.0));
    x: (Rand.wrap(Rand.hash(n + 0.5) * w + t * drift, w) - 16
        + sin((t * (0.5 + Rand.hash(n + 4.0)) + Rand.hash(n + 5.0) * 6.28) * 1rad) * sway) * 1px - self.width / 2;
    y: (Rand.wrap(Rand.hash(n + 3.0) * h + t * v, h) - 16) * 1px - self.height / 2;
}

export component AmbientScene inherits Rectangle {
    in property <SceneInfo> info;
    in property <bool> animated: true;
    in property <bool> fade: true;
    in property <color> fade-to: #111318;
    // Seconds; frozen when animations are off.
    property <float> t: animated ? animation-tick() / 1ms / 1000 + 40 : 40;
    clip: true;
    background: @linear-gradient(180deg, info.sky-top 0%, info.sky-bottom 100%);

    // Stars, twinkling.
    if info.night > 0.01: Rectangle {
        for i in 48: Rectangle {
            width: (0.8 + Rand.hash(i + 100.0) * 1.6) * 2px;
            height: self.width;
            border-radius: self.width / 2;
            x: Rand.hash(i + 200.0) * root.width;
            y: Rand.hash(i + 300.0) * root.height * 0.72;
            background: white;
            opacity: root.info.night * 0.9 * (0.35 + 0.65 * (sin((root.t * (0.6 + Rand.hash(i + 400.0) * 2) + Rand.hash(i + 500.0) * 6.28) * 1rad) + 1) / 2);
        }
    }

    // The sun, glowing.
    if info.sun-alpha > 0: Rectangle {
        property <length> glow: 150px * (1 + 0.05 * sin(root.t * 0.9rad));
        x: root.info.sun-x * root.width - self.width / 2;
        y: root.info.sun-y * root.height - self.height / 2;
        width: glow;
        height: glow;
        opacity: 0.55 * root.info.sun-alpha;
        background: @radial-gradient(circle, root.info.sun-color 0%, root.info.sun-color.transparentize(1) 70%);
    }
    if info.sun-alpha > 0: Rectangle {
        x: root.info.sun-x * root.width - self.width / 2;
        y: root.info.sun-y * root.height - self.height / 2;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: root.info.sun-color;
        opacity: root.info.sun-alpha;
    }

    // The moon: a soft glow and a crescent, bobbing slightly.
    if info.moon-alpha > 0: Rectangle {
        x: root.info.moon-x * root.width - self.width / 2;
        y: root.info.moon-y * root.height - self.height / 2;
        width: 120px;
        height: 120px;
        opacity: 0.3 * root.info.moon-alpha;
        background: @radial-gradient(circle, #e8e6ff 0%, #e8e6ff00 70%);
    }
    if info.moon-alpha > 0: Path {
        x: root.info.moon-x * root.width - self.width / 2;
        y: root.info.moon-y * root.height - self.height / 2 + 2px * sin(root.t * 0.4rad);
        width: 30px;
        height: 30px;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 0 A 50 50 0 1 0 50 100 A 66 66 0 0 1 50 0 Z";
        fill: #f6f2de;
        opacity: root.info.moon-alpha;
    }

    // Clouds drifting across by day.
    if info.night < 0.98: Rectangle {
        for i in 4: Path {
            property <length> w: (0.7 + Rand.hash(i + 600.0) * 0.6) * 110px;
            property <float> span: (root.width + self.w * 2) / 1px;
            x: Rand.wrap(Rand.hash(i + 700.0) * span + root.t * (4 + Rand.hash(i + 800.0) * 6), span) * 1px - self.w;
            y: root.height * (0.1 + Rand.hash(i + 900.0) * 0.3);
            width: self.w;
            height: self.w * 0.5;
            viewbox-width: 100;
            viewbox-height: 50;
            commands: "M 8 50 A 16 16 0 0 1 22 26 A 24 24 0 0 1 66 20 A 18 18 0 0 1 92 38 A 12 12 0 0 1 92 50 Z";
            fill: #ffc9a8.mix(white, root.info.gold);
            opacity: (1 - root.info.night) * 0.3;
        }
    }

    // Winter: snow.
    if info.season == 3: Rectangle {
        for i in 34: Faller {
            n: i;
            t: root.t;
            area-width: root.width;
            area-height: root.height;
            speed: 22;
            sway: 10;
            width: (1.3 + 2.4 * Rand.hash(i + 1.0)) * 2px;
            height: self.width;
            // Set corner by corner: the shorthand doesn't reach a component's base.
            border-top-left-radius: self.width / 2;
            border-top-right-radius: self.width / 2;
            border-bottom-left-radius: self.width / 2;
            border-bottom-right-radius: self.width / 2;
            background: white;
            opacity: 0.55 + 0.4 * Rand.hash(i + 1.0);
        }
    }

    // Spring: petals tumbling.
    if info.season == 0: Rectangle {
        for i in 20: Faller {
            n: i;
            t: root.t;
            area-width: root.width;
            area-height: root.height;
            speed: 16;
            sway: 14;
            drift: 10;
            // An almond-shaped petal: two round corners, two pointed.
            width: 12px * (0.7 + 0.6 * Rand.hash(i + 1.0));
            height: self.width * 0.7;
            border-top-left-radius: self.height;
            border-bottom-right-radius: self.height;
            border-top-right-radius: self.height * 0.25;
            border-bottom-left-radius: self.height * 0.25;
            background: Rand.hash(i + 7.0) < 0.5 ? #f7b6cf : #ffd6e5;
            transform-rotation: (root.t * (40 + 90 * Rand.hash(i + 4.0)) + Rand.hash(i + 5.0) * 360) * 1deg;
            opacity: 0.9;
        }
    }

    // Autumn: leaves swinging down.
    if info.season == 2: Rectangle {
        for i in 16: Faller {
            n: i;
            t: root.t;
            area-width: root.width;
            area-height: root.height;
            speed: 18;
            sway: 18;
            drift: -6;
            width: (9 + 6 * Rand.hash(i + 1.0)) * 1px;
            height: self.width * 0.55;
            border-top-left-radius: self.height;
            border-bottom-right-radius: self.height;
            background: Rand.hash(i + 8.0) < 0.25 ? #e07a3f : Rand.hash(i + 8.0) < 0.5 ? #c8553d : Rand.hash(i + 8.0) < 0.75 ? #e9a23b : #a0522d;
            transform-rotation: (sin((root.t * (0.8 + Rand.hash(i + 4.0)) + Rand.hash(i + 5.0) * 6.28) * 1rad) * 70 + Rand.hash(i + 5.0) * 360) * 1deg;
            opacity: 0.92;
        }
    }

    // Summer: motes of light rising by day, fireflies by night.
    if info.season == 1 && info.night < 0.98: Rectangle {
        for i in 18: Faller {
            n: i;
            t: -root.t;
            area-width: root.width;
            area-height: root.height;
            speed: 7;
            sway: 8;
            width: (1.4 + 1.8 * Rand.hash(i + 1.0)) * 2px;
            height: self.width;
            border-top-left-radius: self.width / 2;
            border-top-right-radius: self.width / 2;
            border-bottom-left-radius: self.width / 2;
            border-bottom-right-radius: self.width / 2;
            background: #fff8dc;
            drop-shadow-blur: 6px;
            drop-shadow-color: #fff4c2;
            opacity: (1 - root.info.night) * (0.4 + 0.4 * max(0, sin((root.t * 1.3 + Rand.hash(i + 5.0) * 6.28) * 1rad)));
        }
    }
    if info.season == 1 && info.night > 0.02: Rectangle {
        for i in 18: Rectangle {
            x: root.width * Rand.hash(i + 0.5) + sin((root.t * (0.25 + Rand.hash(i + 4.0) * 0.3) + Rand.hash(i + 5.0) * 6.28) * 1rad) * 34px;
            y: root.height * (0.2 + 0.7 * Rand.hash(i + 3.0)) + cos((root.t * (0.3 + Rand.hash(i + 2.0) * 0.3) + Rand.hash(i + 5.0) * 6.28) * 1rad) * 18px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: #f4ffb8;
            drop-shadow-blur: 8px;
            drop-shadow-color: #e6ff8a;
            opacity: root.info.night * max(0, sin((root.t * (1.2 + Rand.hash(i + 1.0)) + Rand.hash(i + 5.0) * 6.28) * 1rad));
        }
    }

    // Diwali: two strings of twinkling lights across the top.
    if info.occasion == 1: Rectangle {
        for i in 60: Rectangle {
            property <int> strand: i >= 30 ? 1 : 0;
            property <float> f: (mod(i, 30) + 1.0) / 31.0;
            property <length> top: self.strand == 0 ? 10px : 4px;
            property <length> sag: self.strand == 0 ? 22px : 40px;
            property <float> glow: 0.45 + 0.55 * (sin((root.t * 2.6 + i * 1.7) * 1rad) + 1) / 2;
            property <int> pick: mod(i + self.strand * 2, 5);
            property <color> c: self.pick == 0 ? #ffd54f : self.pick == 1 ? #ff8a65 : self.pick == 2 ? #f06292 : self.pick == 3 ? #ffb300 : #aed581;
            x: root.width * self.f - 3px;
            y: self.top + self.sag * 4 * self.f * (1 - self.f) + 1px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: self.c;
            drop-shadow-blur: 8px;
            drop-shadow-color: self.c;
            opacity: 0.6 + 0.4 * self.glow;
        }
    }

    // Fireworks at New Year, and on Diwali nights.
    if info.occasion == 2 || (info.occasion == 1 && info.night > 0.4): Rectangle {
        for s in 44: Rectangle {
            property <int> lane: s >= 22 ? 1 : 0;
            property <float> lt: root.t + self.lane * 1.4;
            property <float> k: floor(self.lt / 2.8);
            property <float> p: (self.lt - self.k * 2.8) / 2.8;
            property <float> seed: self.k * 2 + self.lane;
            property <float> ease: 1 - (1 - self.p) * (1 - self.p);
            property <float> a: mod(s, 22) / 22.0 * 6.283 + Rand.hash(self.seed + s) * 0.2;
            property <length> radius: (46 + 30 * Rand.hash(self.seed * 1.7)) * 1px * self.ease;
            property <float> pick: Rand.hash(self.seed * 9.7);
            property <bool> warm: root.info.occasion == 1;
            property <color> c: self.warm
                ? (self.pick < 0.33 ? #ffd54f : self.pick < 0.66 ? #ff8a65 : #ffb74d)
                : (self.pick < 0.25 ? #80deea : self.pick < 0.5 ? #f48fb1 : self.pick < 0.75 ? #fff176 : #b39ddb);
            x: (0.15 + 0.7 * Rand.hash(self.seed * 7.1)) * root.width + cos(self.a * 1rad) * self.radius - 2px;
            y: (0.15 + 0.3 * Rand.hash(self.seed * 3.3)) * root.height + sin(self.a * 1rad) * self.radius + 26px * self.p * self.p - 2px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: self.c;
            drop-shadow-blur: 6px;
            drop-shadow-color: self.c;
            opacity: (root.info.occasion == 2 ? 0.5 + root.info.night / 2 : root.info.night) * (1 - self.p);
        }
    }

    // Valentine's Day: hearts floating up.
    if info.occasion == 3: Rectangle {
        for i in 12: Faller {
            n: i + 40;
            t: -root.t;
            area-width: root.width;
            area-height: root.height;
            speed: 13;
            sway: 12;
            width: (12 + 8 * Rand.hash(i + 41.0)) * 1px;
            height: self.width;
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 100;
                viewbox-height: 100;
                commands: "M 50 88 C 8 58 12 12 50 34 C 88 12 92 58 50 88 Z";
                fill: mod(i, 3) == 0 ? #e57373 : #f48fb1;
                opacity: 0.8;
            }
        }
    }

    // Melt into the page below.
    if fade: Rectangle {
        y: parent.height * 0.35;
        height: parent.height * 0.65;
        background: @linear-gradient(180deg, root.fade-to.transparentize(1) 0%, root.fade-to 100%);
    }
}
